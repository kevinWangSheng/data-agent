# Copy to ~/.config/data-agent/env (chmod 600) and fill in. Keep it out of the repo so it can never be
# committed; the agent container (plan §6, not built yet) will read it at start.
# Names are DATA_AGENT_* on purpose: exporting ANTHROPIC_* would also redirect your own Claude Code.
# The data agent passes these to its SDK subprocess only, as ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN /
# ANTHROPIC_MODEL (plan §6).
DATA_AGENT_BASE_URL=https://api.deepseek.com/anthropic
DATA_AGENT_API_KEY=
DATA_AGENT_MODEL=deepseek-flash
# Optional: only for the 5-task Claude comparison run.
DATA_AGENT_ANTHROPIC_API_KEY=
