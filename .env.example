# Copy to .env and fill in. .env is gitignored and coding agents are denied read access.
# Model endpoint for the data agent (DeepSeek's Anthropic-compatible API by default).
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=deepseek-flash
# Optional: only for the 5-task Claude comparison run.
ANTHROPIC_API_KEY=
