# Secrets — never commit. Real keys live in ~/.config/data-agent/env (see .env.example).
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Node
node_modules/
.next/
# The built UI `data-agent web` serves from a checkout (`pnpm --dir web build:local`); a wheel
# gets its own build (hatch_build.py).
src/data_agent/web/static/

# Run outputs stay out of git; only summary reports are committed
runs/
jobs/

# Coding-agent worktrees and per-user overrides
.claude/worktrees/
.claude/settings.local.json

# Local databases
*.duckdb
*.duckdb.wal
!tests/fixtures/*.duckdb

.DS_Store

# Playwright MCP browser-tool debug output (console logs, page snapshots, screenshots)
.playwright-mcp/
