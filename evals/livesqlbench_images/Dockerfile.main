# The `main` image of a LiveSQLBench task (ticket 128 Context 9.3): where the agent works and the
# verifier (tests/livesqlbench_verifier.py) runs. Python 3.12 for the agent's own virtualenv
# (evals.harbor_agent installs it; pyproject.toml requires 3.12), and psycopg, pinned to uv.lock's
# version, for the verifier's system Python. No credential, no database client, no data; the
# database's public assets are mounted at /app/db_assets by the task's compose file.
# Built by `python -m evals livesqlbench prepare` on the server, never pushed to a registry.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.10.8 /uv /usr/local/bin/uv
RUN uv pip install --system --no-cache "psycopg[binary]==3.3.6" && rm /usr/local/bin/uv
WORKDIR /app
